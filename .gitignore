# Artefatos de build (o frontend mora em frontend/)
node_modules/
frontend/dist/
frontend/coverage/

# Variaveis de ambiente. O padrao amplo veio da branch dev e e o mais seguro:
# ignora qualquer .env, com excecao explicita do exemplo.
# ATENCAO: .env.production ja estava rastreado antes desta regra. Ignorar nao
# destraqueia — rode `git rm --cached .env.production` e passe a URL por build
# arg do Docker ou variavel do GitHub Actions.
.env
.env.*
!.env.example

# Fora do controle de versao por decisao do usuario em 13/09/2026: RFC, Wiki,
# planos de handoff e atribuicoes de licenca. Os arquivos continuam no disco.
docs/

# Editores e SO
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.log

# Servico de visao
visao/.venv/
visao/capturas/
visao/saida/
__pycache__/
*.pyc
frontend/.vite/

# Ocorrencias aguardando reenvio quando a API esteve fora do ar.
# Sao dados de operacao, e podem conter horario e camera de um evento real.
visao/dados/fila/

# Dados de validacao da IA: videos e cache de features nao entram no Git.
# Sao dados de imagem (LGPD) e nao pertencem a um repositorio. Anotacoes e
# resultados (metricas.md, erros.csv) sao rastreados.
visao/dados/videos/
visao/dados/clipes/
visao/dados/cache/
