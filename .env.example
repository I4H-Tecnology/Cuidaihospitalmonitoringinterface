# =============================================================================
#  Copie para .env e ajuste. O .env NÃO vai para o git.
#      cp .env.example .env
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
POSTGRES_DB=medsignal
POSTGRES_USER=medsignal
# Troque por uma senha sua. Sem valor padrão de propósito: o compose recusa subir
# sem isso, para ninguém acabar rodando com "postgres/postgres" em produção.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Frontend ----------------------------------------------------------------
# O `npm run dev` (frontend/, direto no Windows) lê este mesmo arquivo: ver
# frontend/vite.config.ts.
# Endereço da API visto pelo NAVEGADOR. Em desenvolvimento é localhost, mesmo
# que a API rode dentro do Docker — quem faz a requisição é o seu navegador.
VITE_API_URL=http://localhost:8000
# Porta do `npm run dev`. A API só libera CORS para ela; ocupada, o Vite recusa
# subir em vez de pular para outra.
FRONTEND_DEV_PORT=5173
FRONTEND_PORT=8080

# --- Backend (FastAPI) — usado só com `--profile backend` --------------------
# Caminho do repositório do backend, relativo a esta pasta.
BACKEND_PATH=../medsignal-backend
BACKEND_PORT=8000
# Chave de assinatura dos tokens. Gere uma com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Ambiente. "dev" mostra na tela o codigo de recuperacao de senha (ainda nao ha
# envio de e-mail). Em QA e producao deixe "producao" ou apague a linha.
MEDSIGNAL_AMBIENTE=dev

# --- Ferramentas -------------------------------------------------------------
ADMINER_PORT=8081
# Dozzle: logs ao vivo dos contêineres (só abre em 127.0.0.1).
DOZZLE_PORT=8888
# SonarQube (perfil `qualidade`; roteiro no docker-compose.yml). A porta só abre
# em 127.0.0.1. Deixe a senha do banco do Sonar vazia para usar o padrão: ele
# só existe dentro da rede do compose.
SONAR_PORT=9000
SONAR_DB_PASSWORD=
# Token gerado na interface do SonarQube (Minha conta > Segurança). Sem ele o
# scanner leva "Not authorized".
SONAR_TOKEN=

# =============================================================================
#  MODO DE TESTE — vale para o PROJETO INTEIRO
#
#  Ligado (true):
#    - o servico de visao usa a WEBCAM local em vez da camera IP
#    - a interface exibe uma faixa de "modo de teste" em todas as telas. Ela le o modo
#      EFETIVO do backend (GET /api/modo-de-teste), nao uma copia gravada no build do painel;
#      por isso o backend tambem recebe esta flag (docker-compose.yml)
#    - ocorrencias geradas ficam marcadas como teste, nunca se passam por reais
#
#  Desligado (false) = operacao: a fonte precisa ser RTSP e a faixa some.
#  A webcam so e aceita com esta flag ligada — ver visao/app/config.py.
# =============================================================================
MEDSIGNAL_MODO_TESTE=true

# --- Servico de visao computacional ------------------------------------------
# webcam | rtsp | arquivo
VISAO_FONTE=webcam
# Descubra o indice certo com: python visao/verificar_camera.py --listar
VISAO_WEBCAM_INDICE=0
# Camera IP. Ex.: rtsp://usuario:senha@192.168.0.10:554/stream1
VISAO_RTSP_URL=
# Video gravado, para ensaiar sem depender de camera
VISAO_ARQUIVO=
# Queda dura ~1s; 8 fps ja da margem para a analise temporal com folga
VISAO_FPS_ALVO=8
VISAO_LARGURA=640
VISAO_API_URL=http://localhost:8000
VISAO_TENANT=clinica-demo

# --- Registro de ocorrencias (RF13, RF14) ------------------------------------
# Camera cadastrada que este processo observa. VAZIO = detecta e mostra na tela,
# mas nao registra nada no banco. Descubra o id rodando:
#     docker compose exec -T db psql -U medsignal -d medsignal #       -v tenant="'clinica-demo'" -v login="'servico-visao'" -v senha="'...'" #       -f /scripts/criar-servico-visao.sql
VISAO_CAMERA_ID=
# Conta de maquina criada pelo script acima. Perfil SYSTEM, permissao apenas de
# ver a propria camera e registrar ocorrencia.
VISAO_API_LOGIN=servico-visao
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISAO_API_SENHA=

# Clipe de evidencia por ocorrencia (RNF05, RN08, RN09): 5 s antes + 5 s depois,
# apagado apos 24 h. A pasta padrao e visao/dados/clipes, que o compose monta na
# API para servir ao painel. VISAO_CLIPES=false desliga a gravacao.
VISAO_CLIPES=true
VISAO_CLIPES_RETENCAO_HORAS=24

# Log estruturado, nos dois servicos (API e visao): json | texto
LOG_LEVEL=INFO
LOG_FORMATO=json

# Servidor do servico de visao. O frontend consome o video daqui.
VISAO_PORTA=8001
# URL que o NAVEGADOR usa para buscar o video. Em webcam o servico roda nativo
# no Windows, entao e localhost mesmo quando o resto esta em container.
VITE_VISAO_URL=http://localhost:8001

# --- Modulo financeiro --------------------------------------------------------
# Embutido na API (o normal no MedSignal) nao precisa de nada aqui: usa o mesmo
# banco e o mesmo login. As duas variaveis abaixo so valem para o MODO SERVICO
# (docker compose --profile financeiro-servico up -d --build financeiro), o
# jeito de outro sistema (Laravel, Node...) usar o modulo por HTTP com JWT.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINANCEIRO_JWT_SEGREDO=
FINANCEIRO_PORT=8100
# Fuso do "hoje" do financeiro (vencimento, atraso). Padrao: America/Sao_Paulo.
FINANCEIRO_FUSO=America/Sao_Paulo
