# Copie para ".env" NESTA pasta (deploy/) e preencha. O ".env" nunca vai para o git.
# Não cole os valores reais em chat, print ou commit.

# Endereço público, sem http:// e sem barra. Exemplos:
#   meusistema.tech                  (domínio que você apontou para o IP da VPS)
#   203-0-113-10.sslip.io            (enquanto o domínio não propaga: troque pelos números do IP, com hífens)
#   localhost                        (só para ensaiar no seu computador)
DOMINIO=

POSTGRES_DB=medsignal
POSTGRES_USER=medsignal
# Gere no terminal da VPS com:  openssl rand -hex 24
# (hexadecimal de propósito: caracteres como @ : / quebram a URL do banco)
POSTGRES_PASSWORD=

# Assina os tokens de login. Gere com:  openssl rand -hex 32
SECRET_KEY=

TOKEN_HORAS=8
LOG_LEVEL=INFO
LOG_FORMATO=json

# Quantas horas o clipe de evidência (5 s antes + 5 s depois do alerta) fica guardado.
# A RFC (RNF05) manda 24 h. Esta instalação é uma DEMONSTRAÇÃO (modo de teste, sem
# paciente real), e nela o teto sobe para 30 dias (720 h). 480 = 20 dias.
# O backend e o serviço de visão expurgam a mesma pasta, e os dois leem este valor.
# Atenção ao disco: com a visão em laço e uma queda no vídeo, nasce um clipe a cada volta.
CLIPES_RETENCAO_HORAS=24

# Modo de teste da instalação inteira (backend e serviço de visão). Ligado por padrão: esta VPS é
# uma DEMONSTRAÇÃO. Ligado, o painel mostra a faixa "MODO DE TESTE" em todas as telas (inclusive
# no login), e valem a retenção de clipes acima de 24 h e a importação dos registros de ensaio.
# Para desligar: MEDSIGNAL_MODO_TESTE=false e reiniciar o backend (a faixa some sem rebuild do painel).
# MEDSIGNAL_MODO_TESTE=true

# --- Serviço de visão com vídeo gravado (opcional: profile "visao") ---------
# Arquivo dentro de deploy/videos/ (você coloca; não vai para o git).
VISAO_VIDEO=demo.mp4
# Só preencha DEPOIS de criar a conta de serviço e de saber o id da câmera (ver LEIA-ME).
# Com VISAO_CAMERA_ID vazio o serviço mostra o vídeo mas não registra ocorrência nem ping.
VISAO_CAMERA_ID=
VISAO_API_LOGIN=servico-visao
VISAO_API_SENHA=
# Ajustes para 1 vCPU (valores padrão): fração de CPU, memória e quadros por segundo.
# VISAO_CPUS=0.7
# VISAO_MEMORIA=1536m
# VISAO_FPS_ALVO=5
